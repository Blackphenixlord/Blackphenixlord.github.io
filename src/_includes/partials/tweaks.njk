  <button class="tweaks-fab" id="tweaks-fab" aria-label="Open tweaks panel" aria-expanded="false" aria-controls="tweaks-panel">
    <span class="tweaks-fab-icon" aria-hidden="true">&#x2699;</span> TWEAKS
  </button>
  <div class="tweaks-panel" id="tweaks-panel" aria-label="Visual tweaks">
    <div class="tweaks-panel-header">// visual settings</div>

    <div class="tweaks-row">
      <div class="tweaks-label"><label for="tweak-cursor">Custom cursor</label><small>Green dot crosshair</small></div>
      <label class="tweaks-toggle">
        <input type="checkbox" id="tweak-cursor" checked />
        <span class="tweaks-slider"></span>
      </label>
    </div>
    <div class="tweaks-row">
      <div class="tweaks-label"><label for="tweak-scrollbar">Scroll bar</label><small>Progress indicator</small></div>
      <label class="tweaks-toggle">
        <input type="checkbox" id="tweak-scrollbar" checked />
        <span class="tweaks-slider"></span>
      </label>
    </div>
    <div class="tweaks-row">
      <div class="tweaks-label"><label for="tweak-dyslexia">Dyslexia mode</label><small>OpenDyslexic + wider spacing</small></div>
      <label class="tweaks-toggle">
        <input type="checkbox" id="tweak-dyslexia" />
        <span class="tweaks-slider"></span>
      </label>
    </div>
    <div class="tweaks-row">
      <div class="tweaks-label" id="tweaks-accent-label">Accent color</div>
      <div class="tweaks-swatches" role="radiogroup" aria-labelledby="tweaks-accent-label">
        <button type="button" class="tweaks-swatch active" data-color="green"  role="radio" aria-checked="true"  aria-label="Green"  title="Green"></button>
        <button type="button" class="tweaks-swatch"        data-color="red"    role="radio" aria-checked="false" aria-label="Red"    title="Red"></button>
        <button type="button" class="tweaks-swatch"        data-color="yellow" role="radio" aria-checked="false" aria-label="Yellow" title="Yellow"></button>
        <button type="button" class="tweaks-swatch"        data-color="cyan"   role="radio" aria-checked="false" aria-label="Cyan"   title="Cyan"></button>
      </div>
    </div>
  </div>
