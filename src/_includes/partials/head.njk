{%- set pageUrl = canonicalUrl -%}
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes, maximum-scale=5" />
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}" />
{%- if noindex %}
  <meta name="robots" content="noindex, nofollow" />
{%- else %}
  <link rel="canonical" href="{{ pageUrl }}" />
  <meta name="author" content="{{ site.name }}" />
  <meta name="robots" content="index, follow" />

  <!-- Open Graph -->
  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:url" content="{{ pageUrl }}" />
  <meta property="og:title" content="{{ ogTitle or title }}" />
  <meta property="og:description" content="{{ description }}" />
  <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="{{ site.ogImageAlt }}" />
  <meta property="og:site_name" content="{{ site.name }}" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="{{ ogTitle or title }}" />
  <meta name="twitter:description" content="{{ description }}" />
  <meta name="twitter:image" content="{{ site.url }}{{ site.ogImage }}" />
{%- endif %}

  <meta name="theme-color" content="{{ site.themeColor }}" />
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='10' fill='%230a0e1a'/%3E%3Crect x='2' y='2' width='96' height='96' rx='9' fill='none' stroke='%2300ff41' stroke-width='3'/%3E%3Crect x='0' y='0' width='100' height='26' rx='10' fill='%2300ff41' fill-opacity='0.1'/%3E%3Ccircle cx='13' cy='13' r='4' fill='%23ff5f57'/%3E%3Ccircle cx='27' cy='13' r='4' fill='%23febc2e'/%3E%3Ccircle cx='41' cy='13' r='4' fill='%2328c840'/%3E%3Ctext x='14' y='67' font-family='monospace' font-size='36' font-weight='bold' fill='%2300ff41'%3EJC%3C/text%3E%3C/svg%3E" />
  {#- Fonts are self-hosted, so there is no third-party origin to warm up.
      The two faces above the fold are preloaded; the rest load on demand. -#}
  <link rel="preload" href="/fonts/ShareTechMono-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/Orbitron-900.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/style.css?v={{ site.assetVersion }}" />
  <link rel="stylesheet" href="/icons.css?v={{ site.assetVersion }}" />
  <script>
    /* Marks that JS is available so CSS can safely hide reveal sections.
       Inline and first so there is never a flash of visible-then-hidden. */
    document.documentElement.classList.add('js');
  </script>

{%- if jsonld %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "{{ site.name }}",
    "url": "{{ site.url }}/",
    "image": "{{ site.url }}{{ site.ogImage }}",
    "jobTitle": "Engineering & Computer Science Student",
    "description": "Engineer, developer, and builder. UTRGV dual enrollment student with internships at NASA, Los Alamos, RECON Technologies, and Nerdvana.",
    "email": "mailto:{{ site.email }}",
    "address": { "@type": "PostalAddress", "addressRegion": "TX", "addressCountry": "US" },
    "alumniOf": {
      "@type": "EducationalOrganization",
      "name": "University of Texas Rio Grande Valley",
      "department": "Science Academy — Dual Enrollment"
    },
    "knowsAbout": ["Software Engineering", "Web Development", "Virtual Reality", "Cybersecurity", "STEM Education"],
    "sameAs": ["{{ site.url }}/"]
  }
  </script>
{%- endif %}

{%- if project %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "name": {{ project.title | dump | safe }},
    "url": "{{ site.url }}/work/{{ project.slug }}.html",
    "description": {{ project.summary | dump | safe }},
    "creator": { "@type": "Person", "name": "{{ site.name }}", "url": "{{ site.url }}/" },
    "author":  { "@type": "Person", "name": "{{ site.name }}", "url": "{{ site.url }}/" },
    "sourceOrganization": { "@type": "Organization", "name": {{ project.org | dump | safe }} },
    "keywords": {{ project.stack | join(", ") | dump | safe }},
    "creativeWorkStatus": {{ project.status | dump | safe }}
  }
  </script>
{%- endif %}
