---
pagination:
  data: projects
  size: 1
  alias: project
permalink: "/work/{{ project.slug }}.html"
navKey: projects
ogType: article
eleventyComputed:
  title: "{{ project.title }} | Joshua Collado"
  description: "{{ project.summary }}"
  canonicalUrl: "{{ site.url }}/work/{{ project.slug }}.html"
  crumbs:
    - { name: "Home", href: "/" }
    - { name: "Projects", href: "/projects.html" }
    - { name: "{{ project.title }}", href: "/work/{{ project.slug }}.html" }
---
{%- import "os/ui.njk" as ui -%}
{%- set i = pagination.pageNumber -%}
{%- set prev = projects[i - 1] if i > 0 else projects[projects.length - 1] -%}
{%- set next = projects[i + 1] if i < projects.length - 1 else projects[0] -%}
<div class="page wrap">
  <p><a class="lnk" href="/projects.html"><span aria-hidden="true">&larr;</span> All work</a></p>
  <article class="prog-page" aria-labelledby="pt">
    <header class="app">
      {{ ui.titlebar("~/work/" + project.slug, "running" if project.status == "In progress" else "exit 0") }}
      <div class="app-body">
        {{ ui.prompt("./" + project.slug + " --info") }}
        <p class="eyebrow">{{ project.org }}</p>
        <h1 class="app-title" id="pt">{{ ui.decrypt(project.title) }}</h1>
        <p class="app-sub" style="font-family: var(--f-prose); max-width: 62ch">{{ project.summary }}</p>
      </div>
    </header>

    <dl class="facts reveal" style="margin-top: var(--s-5)">
      <div><dt>Role</dt><dd>{{ project.role }}</dd></div>
      <div><dt>Timeline</dt><dd>{{ project.years }}</dd></div>
      <div><dt>Status</dt><dd>{{ ui.status(project.status) }}</dd></div>
    </dl>

    <section class="term reveal" style="margin-top: var(--s-5)" aria-label="Stack">
      <div class="term-body">
        <p class="tl"><span class="ps-u">{{ project.slug }}</span><span class="ps-c"> $</span> stack --list</p>
        <ul class="tags tags-lg" style="margin-block: var(--s-3)">{% for s in project.stack %}<li>{{ s }}</li>{% endfor %}</ul>
        <p class="tl"><span class="ps-u">{{ project.slug }}</span><span class="ps-c"> $</span> status</p>
        <p class="tl" style="margin-top: var(--s-2)">{{ ui.status(project.status) }}</p>
      </div>
    </section>

    {%- if project.problem or project.approach %}
    <div class="grid-2 sect">
      {%- if project.problem %}
      <section class="card block reveal" aria-labelledby="problem">
        {{ ui.prompt("cat problem.md") }}
        <h2 id="problem">The problem</h2>
        <p class="prose">{{ project.problem }}</p>
      </section>
      {%- endif %}
      {%- if project.approach %}
      <section class="card block reveal" style="--i:1" aria-labelledby="approach">
        {{ ui.prompt("cat approach.md") }}
        <h2 id="approach">What I built</h2>
        <p class="prose">{{ project.approach }}</p>
      </section>
      {%- endif %}
    </div>
    {%- endif %}

    <section class="sect" aria-labelledby="outcome">
      <div class="mission reveal">
        <div class="mission-in block">
          {{ ui.prompt("tail -1 outcome.log") }}
          <h2 id="outcome">Outcome</h2>
          <p style="font-size: clamp(1.15rem, 2.4vw, 1.5rem); line-height: 1.5; max-width: 50ch">{{ project.outcome }}</p>
          {%- if project.result %}<p class="prose" style="margin-top: var(--s-4)">{{ project.result }}</p>{% endif %}
        </div>
      </div>
    </section>

    {%- if project.photos.length %}
    <section aria-labelledby="ph">
      {{ ui.head("Experience in Photos", "ls ./photos", "// photo gallery", "ph") }}
      <div class="gal reveal">
        {%- for p in project.photos %}
        {{ ui.photo(p, "(min-width: 760px) 33vw, 50vw") }}
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    <div class="grid-3 sect">
      {%- if project.link %}
      <div class="card reveal"><p class="k">{{ project.link.label }}</p><a class="lnk" href="{{ project.link.href }}">{{ project.link.title }} <span aria-hidden="true">&rarr;</span></a></div>
      {%- endif %}
      {%- if project.internship %}
      <div class="card reveal"><p class="k">The internship behind it</p><a class="lnk" href="{{ project.internship.href }}">{{ project.internship.label }} <span aria-hidden="true">&rarr;</span></a></div>
      {%- endif %}
      <div class="card reveal"><p class="k">Want the detail?</p><a class="lnk" href="/contact.html">Get in touch <span aria-hidden="true">&rarr;</span></a></div>
    </div>
  </article>

  <nav class="pager" aria-label="Keep reading">
    <a href="/work/{{ prev.slug }}.html" rel="prev"><span aria-hidden="true">&larr;</span> {{ prev.title }}</a>
    <a href="/work/{{ next.slug }}.html" rel="next">{{ next.title }} <span aria-hidden="true">&rarr;</span></a>
  </nav>
</div>
